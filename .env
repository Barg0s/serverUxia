PORT=3000
NODE_ENV=development

# Opciones SQLite (desarrollo)
DB_DIALECT=sqlite
DB_STORAGE=./db/database.sqlite

# Si quieres Postgres/MySQL más adelante:
# DB_DIALECT=postgres
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# SECRET para generar tokens si quieres HMAC (opcional)
APP_SECRET=my_dev_secret_123
