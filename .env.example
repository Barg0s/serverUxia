# Configuración del Servidor en Proxmox / Ubuntu

# Puerto del servidor (Por defecto 3000)
PORT=3000

# Paràmetres Ollama IA - Servidor MarIA
OLLAMA_URL=http://192.168.1.14:11434
OLLAMA_MODEL=llama3.2-vision

# Configuración de Base de Datos (MySQL)
# En Proxmox (Ubuntu), si MySQL está en la misma máquina: localhost
# Si está en otro contenedor/VM, poner la IP.
DB_HOST=localhost
DB_USER=root
DB_PASS=tu_password_aqui
DB_NAME=uxia

# Clave secreta para JWT o similares (si se usa en el futuro)
JWT_SECRET=super_secreto
